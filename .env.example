# ==============================================================================
# WealthCalc India — Environment Variables Configuration
# ==============================================================================

# MongoDB Connection String (Atlas URI or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wealthcalc?retryWrites=true&w=majority

# NextAuth.js Configuration
NEXTAUTH_SECRET=wealthcalc-super-secret-key-change-me
NEXTAUTH_URL=https://etf-calculator-n6b3.vercel.app

# Google OAuth 2.0 Credentials (Optional - Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend / API URLs
NEXT_PUBLIC_API_URL=https://etf-calculator-n6b3.vercel.app
FRONTEND_URL=https://etf-calculator-n6b3.vercel.app
